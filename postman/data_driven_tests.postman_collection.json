              "pm.test(\"Status 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Sprawdzenie poprawnego tytulu z pliku CSV\", function () {\r",
              "    var responseData = pm.response.json();\r",
              "    var expectedTitle = pm.iterationData.get(\"expectedTitle\");\r",
              "    \r",
              "    pm.expect(responseData.title).to.eql(expectedTitle);\r",
              "});"
            ],
